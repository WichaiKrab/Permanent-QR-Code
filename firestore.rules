rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() { return request.auth != null; }
    
    // Check if the user is in the admins collection or matches the owner email
    function isAdmin() { 
      return isSignedIn() && (
               exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
               exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
               request.auth.token.email.lower() == "wsritangkum@gmail.com"
             );
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidLinkRecord(data) {
      return data.keys().hasAll(['id', 'targetUrl', 'name', 'createdAt', 'clicks']) &&
             data.id is string && data.id.size() <= 64 &&
             data.targetUrl is string && data.targetUrl.size() <= 2048 &&
             data.name is string && data.name.size() <= 256 &&
             data.createdAt is string &&
             data.clicks is number;
    }

    match /admins/{id} {
       allow list, write: if request.auth.token.email.lower() == "wsritangkum@gmail.com";
       allow get: if isSignedIn() && (id == request.auth.uid || id == request.auth.token.email);
    }

    match /links/{linkId} {
      // Anyone can read a link to be redirected
      allow get: if isValidId(linkId);
      
      // Admins can list all links for the dashboard
      allow list: if isAdmin();

      // Anyone can create a link for the public generator
      allow create: if isValidId(linkId) && 
                       isValidLinkRecord(incoming()) && 
                       incoming().id == linkId &&
                       incoming().keys().hasOnly(['id', 'targetUrl', 'name', 'createdAt', 'updatedAt', 'clicks']);
      
      // Only admins can update the target URL or name, but anyone can increment clicks
      allow update: if isValidId(linkId) && 
                       isValidLinkRecord(incoming()) && (
         (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['targetUrl', 'name', 'updatedAt', 'clicks', 'id'])) ||
         (incoming().diff(existing()).affectedKeys().hasOnly(['clicks']) && incoming().clicks == existing().clicks + 1)
       );

      allow delete: if isAdmin();
    }
  }
}
